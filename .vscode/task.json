{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start PHP Server",
            "type": "shell",
            "command": "php",
            "args": ["-S", "localhost:8000", "-t", "."],
            "isBackground": true,
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Open in Chrome",
            "type": "shell",
            "command": "start",
            "args": ["chrome", "http://localhost:8000/index.html"],
            "group": "build"
        },
        {
            "label": "Launch on Chrome",
            "dependsOn": ["Start PHP Server", "Open in Chrome"],
            "group": "build"
        }
    ]
}

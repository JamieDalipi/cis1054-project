{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start PHP Server",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "start",
                "/B",
                "php",
                "-d",
                "xdebug.mode=debug",
                "-d",
                "xdebug.start_with_request=yes",
                "-d",
                "xdebug.client_host=127.0.0.1",
                "-d",
                "xdebug.client_port=9003",
                "-S",
                "localhost:8000",
                "-t",
                "."
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Open in Browser",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "start",
                "",
                "http://localhost:8000/homepage.html"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Launch on Chrome",
            "dependsOn": ["Start PHP Server", "Open in Browser"],
            "dependsOrder": "sequence",
            "group": "build"
        }
    ]
}

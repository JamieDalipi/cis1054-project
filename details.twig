<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ item.name }}</title>
</head>
<body>

<h1>{{ item.name }}</h1>

<img src="{{ item.image }}" alt="{{ item.name }}">

<p>{{ item.desc }}</p>

<p>{{ item.longDesc }}</p>

<p>Category: {{ item.category }}</p>

<p>Price: €{{ item.price }}</p>

</body>
</html>

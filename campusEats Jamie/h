ul {
    box-sizing: border-box;
    display: flex;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background-color: black;
    margin: 0;
    list-style: none;
    z-index: 9999;
}
ul li:first-child{
    margin-right: auto;
}
ul li a {
    display: flex;
    color: gray;
    font-family: "MyOtherCustomFont", "Roboto", "Open Sans", Arial, Helvetica, sans-serif;
    text-align: center;
    padding: 15px 20px;
    text-decoration: none;
    font-size: 2.5rem;
}
ul li b{
    font-size: 3rem;
    color: yellow;
    text-shadow: black 2px 2px;
    display: block;
    font-family: "MyCustomFont", "Roboto", "Open Sans", Arial, Helvetica, sans-serif;
    text-align: center;
    padding: 14px 0px;
    text-decoration: none;
}

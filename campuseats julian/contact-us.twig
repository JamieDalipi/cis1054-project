  <input type="text" id="fname" name="fname"><br>
  <span class="<?php
       if(!empty($nameErr)){
           echo 'error-input';
       }
       ?>"></span>
<br><br>
  <label for="email">Email:   *</label><br>
  <input type="email" name="email"><br>
  <span class="<?php
       if(!empty($emailErr)){
           echo 'error-input';
       }
       ?>"></span>
  <br><br>
  <label for="pnumber">Phone Number:   *</label><br>
